{
  "name": "@luckycurve/pi-loop",
  "version": "0.1.0",
  "description": "Recurring prompt loops for pi: /loop 5m <prompt>, with skip-when-busy and an agent-controlled break that waits for you",
  "type": "module",
  "license": "MIT",
  "author": "LuckyCurve",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "loop",
    "interval",
    "cron",
    "schedule",
    "polling"
  ],
  "homepage": "https://github.com/LuckyCurve/pi-loop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuckyCurve/pi-loop.git"
  },
  "bugs": {
    "url": "https://github.com/LuckyCurve/pi-loop/issues"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "README.zh-CN.md",
    "AGENTS.md",
    "PUBLISHING.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/loop/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
